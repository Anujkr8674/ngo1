// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryCategory {
  id        String         @id @default(cuid())
  name      String         @unique
  createdAt DateTime       @default(now())
  images    GalleryImage[]
}

model GalleryImage {
  id          String          @id @default(cuid())
  url         String
  caption     String?
  categoryId  String
  category    GalleryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
}

model BlogCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  posts     BlogPost[]
}

model BlogPost {
  id         String        @id @default(cuid())
  title      String
  slug       String        @unique
  content    String        @db.Text
  excerpt    String?       @db.Text
  author     String        @default("Admin")
  readTime   Int           @default(3)
  images     String[]      // Array of image URLs
  published  Boolean       @default(true)
  categoryId String?
  category   BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model TeamMember {
  id          String   @id @default(cuid())
  name        String
  role        String
  image       String   // URL of image stored in Supabase
  email       String?
  mobile      String?
  description String   @db.Text // Rich text html from Tiptap Editor
  order       Int      @default(0) // Display sorting order
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AgmReport {
  id        String   @id @default(cuid())
  title     String
  date      String   // e.g. "May 2026"
  url       String   // Local path or Supabase Storage URL
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ArchivedMaterial {
  id        String   @id @default(cuid())
  title     String
  size      String   // e.g. "2.4 MB"
  url       String   // Supabase Storage URL
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DonorCSRMember {
  id        String   @id @default(cuid())
  title     String
  src       String   // Public folder path or Supabase Storage URL
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentSheet {
  id        String   @id @default(cuid())
  title     String
  src       String   // Public folder path or Supabase URL
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InitiativeCategory {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  iconName    String       @default("Sparkles")
  order       Int          @default(0)
  initiatives Initiative[]
}

model Initiative {
  id         String             @id @default(cuid())
  title      String
  desc       String
  details    String
  sponsor    String
  image      String             // Public path or Supabase URL
  order      Int                @default(0)
  categoryId String
  category   InitiativeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  video     String   // Public path or Supabase URL
  image     String   // Public path or Supabase URL
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  mobile    String
  subject   String
  message   String
  createdAt DateTime @default(now())
}






