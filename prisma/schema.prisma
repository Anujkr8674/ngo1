// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryCategory {
  id        String         @id @default(cuid())
  name      String         @unique
  createdAt DateTime       @default(now())
  images    GalleryImage[]
}

model GalleryImage {
  id          String          @id @default(cuid())
  url         String
  caption     String?
  categoryId  String
  category    GalleryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
}

model BlogCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  posts     BlogPost[]
}

model BlogPost {
  id         String        @id @default(cuid())
  title      String
  slug       String        @unique
  content    String        @db.Text
  excerpt    String?       @db.Text
  author     String        @default("Admin")
  readTime   Int           @default(3)
  images     String[]      // Array of image URLs
  published  Boolean       @default(true)
  categoryId String?
  category   BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model TeamMember {
  id          String   @id @default(cuid())
  name        String
  role        String
  image       String   // URL of image stored in Supabase
  email       String?
  mobile      String?
  description String   @db.Text // Rich text html from Tiptap Editor
  order       Int      @default(0) // Display sorting order
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AgmReport {
  id        String   @id @default(cuid())
  title     String
  date      String   // e.g. "May 2026"
  url       String   // Local path or Supabase Storage URL
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ArchivedMaterial {
  id        String   @id @default(cuid())
  title     String
  size      String   // e.g. "2.4 MB"
  url       String   // Supabase Storage URL
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DonorCSRMember {
  id        String   @id @default(cuid())
  title     String
  src       String   // Public folder path or Supabase Storage URL
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentSheet {
  id        String   @id @default(cuid())
  title     String
  src       String   // Public folder path or Supabase URL
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InitiativeCategory {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  iconName    String       @default("Sparkles")
  order       Int          @default(0)
  initiatives Initiative[]
}

model Initiative {
  id         String             @id @default(cuid())
  title      String
  desc       String
  details    String
  sponsor    String
  image      String             // Public path or Supabase URL
  order      Int                @default(0)
  categoryId String
  category   InitiativeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  video     String   // Public path or Supabase URL
  image     String   // Public path or Supabase URL
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  mobile    String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model Donation {
  id             String   @id @default(cuid())
  title          String
  name           String
  mobile         String
  email          String
  state          String
  address        String
  postalCode     String
  amount         Float
  purpose        String
  paymentMode    String
  dateOfPayment  String
  transactionId  String
  panCard        String?
  suggestions    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model HelpEachOther {
  id            String   @id @default(cuid())
  category      String
  name          String
  gender        String
  age           Int?
  dob           String
  address       String
  state         String
  postalCode    String
  mobile        String
  email         String?
  language      String
  bloodGroup    String?
  qualification String?
  profession    String?
  helpTypes     String[]
  otherHelp     String?
  suggestions   String?
  idProofUrl    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model EducationSupport {
  id                 String   @id @default(cuid())
  studentName        String
  className          String
  gender             String
  dob                String
  parentName         String
  annualIncome       Float?
  address            String
  state              String
  postalCode         String
  mobile             String
  email              String?
  language           String
  schoolName         String
  schoolAddress      String
  schoolState        String
  schoolPin          String
  teacherName        String
  teacherPhone       String
  admissionFee       Float?
  tuitionFee         Float?
  booksCost          Float?
  stationeryCost     Float?
  totalAmountWords   String
  totalAmountFigure  Float
  otherSupport       String[]
  accountNo          String
  ifsc               String
  idProofUrl         String?
  photoUrl           String?
  passbookUrl        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ElderlySupport {
  id               String   @id @default(cuid())
  name             String
  gender           String
  age              Int
  address          String
  mobile           String
  email            String?
  livingStatus     String
  language         String
  emergencyContact String
  emergencyPhone   String
  healthStatus     String?
  supportTypes     String[]
  otherSupport     String?
  suggestions      String?
  idProofUrl       String?
  photoUrl         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model MedicalSupport {
  id           String   @id @default(cuid())
  name         String
  gender       String
  dob          String
  address      String
  state        String
  postalCode   String
  mobile       String
  email        String?
  language     String
  healthStatus String?
  supportTypes String[]
  otherSupport String?
  reason       String
  idProofUrl   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Volunteer {
  id            String   @id @default(cuid())
  name          String
  gender        String
  dob           String
  address       String
  state         String
  postalCode    String
  mobile        String
  email         String
  language      String
  qualification String
  profession    String
  company       String
  interests     String[]
  otherInterest String?
  hoursPerWeek  String
  reason        String?
  idProofUrl    String?
  photoUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Member {
  id                String   @id @default(cuid())
  name              String
  fatherSpouseName  String
  gender            String
  dob               String
  address           String
  state             String
  postalCode        String
  mobile            String
  email             String
  pancard           String
  education         String
  profession        String
  company           String
  interests         String[]
  otherInterest     String?
  reason            String?
  modeOfPayment     String
  paymentDate       String
  chequeNo          String?
  bankName          String?
  transactionId     String?
  idProofUrl        String?
  residenceProofUrl String?
  photoUrl          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model HomepageStat {
  id        String   @id @default(cuid())
  value     Int
  suffix    String   @default("+")
  label     String
  desc      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CsrPartnership {
  id        String   @id @default(cuid())
  company   String
  desc      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}








